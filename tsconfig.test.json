{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "ignoreDeprecations": "6.0",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist",
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["packages/domain/src/**/*.ts", "packages/domain/tests/**/*.ts"]
}
