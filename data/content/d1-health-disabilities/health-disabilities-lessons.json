      "content_blocks": [
        {
          "type": "heading",
          "text": "Föraren ska känna till, inte fastställa tillstånd",
          "fact_keys": [
            "D1-HEALTH-ROLE-FACT-001",
            "D1-HEALTH-ROLE-FACT-002"
          ]
        },
        {
          "type": "paragraph",
          "text": "I det här ämnet handlar kunskapen om trygg transport. Du behöver förstå vilka praktiska behov som kan uppstå, men du ska inte avgöra vilket tillstånd en passagerare har.",
          "fact_keys": [
            "D1-HEALTH-ROLE-FACT-002",
            "D1-HEALTH-ROLE-FACT-003"
          ]
        },
        {
          "type": "bullet_list",
          "items": [
            "Fråga vad passageraren vill ha hjälp med.",
            "Ge tid för svar och bekräfta nästa steg.",
            "Dela bara information som behövs för uppdragets säkerhet."
          ],
          "fact_keys": [
            "D1-HEALTH-ROLE-FACT-003",
            "D1-HEALTH-ROLE-FACT-004"
          ]
        },
        {
          "type": "example",
          "text": "En passagerare verkar osäker på adressen. Ett bra svar är att lugnt kontrollera bokningen, läsa upp adressen kort och fråga om den stämmer.",
          "fact_keys": [
            "D1-HEALTH-ROLE-FACT-004",
            "D1-HEALTH-ROLE-FACT-005"
          ]
        },
        {
          "type": "checkpoint",
          "text": "Kan du skilja mellan praktisk assistans och att försöka fastställa passagerarens tillstånd?",
          "fact_keys": [
            "D1-HEALTH-ROLE-FACT-005",
            "D1-HEALTH-ROLE-FACT-006"
          ]
        }
