      "requirement_key": "D1-SAFE-011-003",
      "fact_text": "Taxiforaren ska kunna redogora for hur man agerar nar man kommer forst till en olycksplats.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 11 § 3",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
