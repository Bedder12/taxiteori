      "requirement_key": "D1-SAFE-011-004",
      "fact_text": "Taxiforaren ska kunna tillampa kunskap om risker vid atgarder under nodsituation pa vagen.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 11 § 4",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
