  "facts": [
    {
      "stable_key": "D1-SAFE-TRIP-FACT-001",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-001",
      "fact_text": "Taxiforaren ska ta ansvar for egen, passagerares och andra medtrafikanters sakerhet i samband med farden.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 10 §",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-TRIP-FACT-002",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-002",
      "fact_text": "Koruuppdraget ska utforas sa att passageraren upplever resan som trygg, saker och bekvam.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 10 §",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-TRIP-FACT-003",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-001",
      "fact_text": "Saker taxikorning innebar att hastighet, avstand, placering och stoppplats anpassas efter trafikmiljon och passagerarens situation.",
      "source_id": "SFS_1998_1276",
      "exact_reference": "Trafikforordning (1998:1276), 3 kap. 14 §",
      "legal_or_guidance_status": "binding_rule",
      "cross_subject_fact_links": [
        "D2-TRAFFIC-035-002"
      ],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-TRIP-FACT-004",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-002",
      "fact_text": "Bekvam korning far inte ske pa bekostnad av trafiksakerhet; mjuka manovrer, tydlig kommunikation och god framforhallning ska stodja samma sakra fard.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 10 §",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [
        "D1-ECO-PLAN-FACT-001"
      ],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-TRIP-FACT-005",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-001",
      "fact_text": "Vid morker, regn, sno eller halka behover foraren minska risken genom lagre fart, storre avstand och battre placering.",
      "source_id": "TRV_HALKA",
      "exact_reference": "Pa glid? Nej!, rad till trafikant vid halka",
      "legal_or_guidance_status": "official_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-TRIP-FACT-006",
      "topic_id": "topic_d1_safety_trygg_saker_resa",
      "requirement_key": "D1-SAFE-010-001",
      "fact_text": "Vid sno, snorok eller nedsatt sikt bor foraren kora langsammare, halla avstand och undvika onodiga riskmoment.",
      "source_id": "TRV_SNO_OVADER",
      "exact_reference": "Rad till trafikant vid sno och besvarligt vaglag",
      "legal_or_guidance_status": "official_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-THREAT-FACT-001",
      "topic_id": "topic_d1_safety_hot_vald",
      "requirement_key": "D1-SAFE-011-001",
      "fact_text": "Taxiforaren ska kunna bedoma lampligt agerande i situationer som kan innebara hot och vald i arbetet.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 11 § 1",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-THREAT-FACT-002",
      "topic_id": "topic_d1_safety_hot_vald",
      "requirement_key": "D1-SAFE-011-001",
      "fact_text": "Arbete med mycket direktkontakt med manniskor kan innebara risk for hot och vald.",
      "source_id": "AV_HOT_VALD",
      "exact_reference": "Vald och hot om vald, arbete med manniskor",
      "legal_or_guidance_status": "official_work_environment_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-THREAT-FACT-003",
      "topic_id": "topic_d1_safety_hot_vald",
      "requirement_key": "D1-SAFE-011-001",
      "fact_text": "Hot- och valdsrisker ska hanteras genom kanda rutiner, instruktioner och rapportering av tillbud.",
      "source_id": "AV_HOT_VALD_RUTINER",
      "exact_reference": "Forebygg och hantera risken for ohalsa i samband med hot och vald",
      "legal_or_guidance_status": "official_work_environment_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-THREAT-FACT-004",
      "topic_id": "topic_d1_safety_hot_vald",
      "requirement_key": "D1-SAFE-011-001",
      "fact_text": "I en hotfull taxissituation ar forarens forsta sakerhetsmal att undvika upptrappning och ta sig ur situationen utan att utsatta sig sjalv, passagerare eller andra for fara.",
      "source_id": "AV_HOT_VALD",
      "exact_reference": "Vald och hot om vald, forebyggande arbete och rutiner",
      "legal_or_guidance_status": "official_work_environment_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-THREAT-FACT-005",
      "topic_id": "topic_d1_safety_hot_vald",
      "requirement_key": "D1-SAFE-011-001",
      "fact_text": "Efter hot, vald eller tillbud ska handelsen rapporteras enligt arbetsplatsens rutiner sa att stod och forebyggande atgarder kan sattas in.",
      "source_id": "AV_HOT_VALD_RUTINER",
      "exact_reference": "Rutiner kring rapportering, stod och instruktioner",
      "legal_or_guidance_status": "official_work_environment_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-001",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Taxiforaren ska kunna tillampa forsta hjalpen och hjart-lungraddning.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 11 § 2",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-002",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Innan HLR pabrorjas ska platsen vara saker for bade hjalparen och personen som behover hjalp.",
      "source_id": "1177_HLR",
      "exact_reference": "Hjart-lungraddning, innan du borjar",
      "legal_or_guidance_status": "authoritative_medical_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-003",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Om en person ar medvetslos och inte gar att vacka ska 112 larmas direkt.",
      "source_id": "1177_HLR",
      "exact_reference": "Hjart-lungraddning, Ring 112",
      "legal_or_guidance_status": "authoritative_medical_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-004",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Om personen inte reagerar och inte andas normalt ska hjartstopp antas och HLR startas omedelbart.",
      "source_id": "1177_HLR",
      "exact_reference": "Nar ska jag starta hjart-lungraddning?",
      "legal_or_guidance_status": "authoritative_medical_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-005",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "HLR pa vuxen bestar av 30 brostkompressioner och 2 inblasningar i cykler.",
      "source_id": "VARDHANDBOKEN_HLR_TEKNIK",
      "exact_reference": "Teknik vid HLR 30:2",
      "legal_or_guidance_status": "authoritative_medical_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-006",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Kompressioner vid vuxen-HLR ska ges i takt cirka 100-120 per minut enligt medicinsk vagledning.",
      "source_id": "VARDHANDBOKEN_HLR_TEKNIK",
      "exact_reference": "Teknik vid HLR 30:2",
      "legal_or_guidance_status": "authoritative_medical_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-SAFE-HLR-FACT-007",
      "topic_id": "topic_d1_safety_forsta_hjalpen_hlr",
      "requirement_key": "D1-SAFE-011-002",
      "fact_text": "Om en medvetslos person andas normalt ska HLR inte startas; personen ska laggas i stabilt sidolage och overvakas tills hjalp kommer.",
      "source_id": "1177_HLR",
