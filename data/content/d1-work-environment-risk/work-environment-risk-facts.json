  "facts": [
    {
      "stable_key": "D1-WORK-WORK-FACT-001",
      "topic_id": "topic_d1_work_arbetsrisker_i_taxiarbetet",
      "requirement_key": "D1-WORK-019-001",
      "fact_text": "Taxiförarens arbete kan innebära upprepade i- och urstigningar, långvarigt sittande, lyft, tidspress, ensamarbete och kontakt med personer i pressade situationer.",
      "source_id": "AV_BELASTNINGSERGONOMI",
      "exact_reference": "Belastningsergonomi, risker i arbetet",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-WORK-FACT-002",
      "topic_id": "topic_d1_work_arbetsrisker_i_taxiarbetet",
      "requirement_key": "D1-WORK-019-001",
      "fact_text": "Arbetsrisker behöver uppmärksammas före och under arbetspasset så att arbetsmetod, paus eller uppdrag kan ändras innan säkerheten påverkas.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 19 §",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-WORK-FACT-003",
      "topic_id": "topic_d1_work_arbetsrisker_i_taxiarbetet",
      "requirement_key": "D1-WORK-019-001",
      "fact_text": "Hot och våld i arbete med direktkontakt ska förebyggas med kända rutiner, instruktioner och rapportering av tillbud.",
      "source_id": "AV_HOT_VALD",
      "exact_reference": "Våld och hot om våld, förebyggande arbete",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-WORK-FACT-004",
      "topic_id": "topic_d1_work_arbetsrisker_i_taxiarbetet",
      "requirement_key": "D1-WORK-019-001",
      "fact_text": "Ensamarbete och nattarbete kan minska möjligheten att snabbt få stöd och gör planering av kontaktvägar och avbrott viktig.",
      "source_id": "AV_HOT_VALD",
      "exact_reference": "Våld och hot om våld, arbete med människor och ensamarbete",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-LIFT-FACT-001",
      "topic_id": "topic_d1_work_belastning_lyft_och_hjalpmedel",
      "requirement_key": "D1-WORK-020-001",
      "fact_text": "Belastningsrisken ökar när lyft sker långt från kroppen, med vriden rygg, i trångt utrymme eller utan möjlighet att variera arbetet.",
      "source_id": "AV_BELASTNINGSERGONOMI",
      "exact_reference": "Belastningsergonomi, belastande arbetsställningar och arbetsrörelser",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-LIFT-FACT-002",
      "topic_id": "topic_d1_work_belastning_lyft_och_hjalpmedel",
      "requirement_key": "D1-WORK-020-001",
      "fact_text": "Upprepade lyft och många in- och urstigningar under ett pass kan ge sammanlagd belastning även när varje enskilt moment känns hanterbart.",
      "source_id": "AV_BELASTNINGSERGONOMI",
      "exact_reference": "Belastningsergonomi, upprepad och långvarig belastning",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-LIFT-FACT-003",
      "topic_id": "topic_d1_work_belastning_lyft_och_hjalpmedel",
      "requirement_key": "D1-WORK-020-002",
      "fact_text": "Vid förflyttning av passagerare ska föraren använda tillgängliga hjälpmedel och be om hjälp när uppgiften inte kan göras säkert ensam.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 20 § 2",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-LIFT-FACT-004",
      "topic_id": "topic_d1_work_belastning_lyft_och_hjalpmedel",
      "requirement_key": "D1-WORK-020-002",
      "fact_text": "Ett säkrare lyft planeras med stabilt underlag, nära arbetsavstånd och tydlig kommunikation med passageraren.",
      "source_id": "AV_ARBETSDON",
      "exact_reference": "Arbetsställningar och arbetsrörelser, planera arbetsrörelsen",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-LIFT-FACT-005",
      "topic_id": "topic_d1_work_belastning_lyft_och_hjalpmedel",
      "requirement_key": "D1-WORK-020-002",
      "fact_text": "Tungt eller otympligt bagage bör hanteras med hjälpmedel eller tillsammans med annan person i stället för att föraren chansar.",
      "source_id": "AV_BELASTNINGSERGONOMI",
      "exact_reference": "Belastningsergonomi, hjälpmedel och organisering",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-POSTURE-FACT-001",
      "topic_id": "topic_d1_work_korstallning_och_variation",
      "requirement_key": "D1-WORK-020-003",
      "fact_text": "En rätt körställning ger föraren kontroll över reglage och sikt utan att kroppen behöver hållas i en onödigt spänd eller vriden position.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 20 § 3",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-POSTURE-FACT-002",
      "topic_id": "topic_d1_work_korstallning_och_variation",
      "requirement_key": "D1-WORK-020-003",
      "fact_text": "Stol, ratt, speglar och nackstöd ska ställas in så att föraren når reglagen, ser runt fordonet och kan arbeta med stöd för kroppen.",
      "source_id": "AV_ARBETSDON",
      "exact_reference": "Arbetsställningar och arbetsrörelser, anpassa arbetsplatsen",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-POSTURE-FACT-003",
      "topic_id": "topic_d1_work_korstallning_och_variation",
      "requirement_key": "D1-WORK-020-003",
      "fact_text": "Långvarigt sittande i samma ställning gör variation, korta avbrott och möjlighet att justera arbetsplatsen viktig.",
      "source_id": "AV_BELASTNINGSERGONOMI",
      "exact_reference": "Belastningsergonomi, långvarigt sittande och variation",
      "verification_status": "verified",
      "authority_status": "occupational_safety_guidance",
      "legal_or_guidance_status": "occupational_safety_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-POSTURE-FACT-004",
      "topic_id": "topic_d1_work_korstallning_och_variation",
      "requirement_key": "D1-WORK-020-003",
      "fact_text": "En förare ska inte lösa en obekväm körställning genom att sträcka sig efter utrustning under pågående körning.",
      "source_id": "TSFS_MOBILTELEFON",
      "exact_reference": "Trafikförordning (1998:1276), 4 kap. 10 e §",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-001",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-001",
      "fact_text": "Läkemedel kan påverka exempelvis vakenhet, reaktionsförmåga eller omdöme; föraren ska läsa varningar och bedöma sin körförmåga.",
      "source_id": "TS_MEDICINER_KORNING",
      "exact_reference": "Läkemedel, körförmåga och medicinska krav",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-002",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-001",
      "fact_text": "Vid osäkerhet om ett läkemedels påverkan ska föraren söka individuell rådgivning och inte chansa med en körning.",
      "source_id": "TS_MEDICINER_KORNING",
      "exact_reference": "Medicinska krav och läkemedel",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-003",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-002",
      "fact_text": "Alkohol och andra droger kan försämra omdöme, uppmärksamhet, reaktion och förmåga att värdera risker.",
      "source_id": "1177_ALKOHOL_DROGER",
      "exact_reference": "Alkohol och påverkan på kroppen och omdömet",
      "verification_status": "verified",
      "authority_status": "authoritative_health_guidance",
      "legal_or_guidance_status": "authoritative_health_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-004",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-002",
      "fact_text": "En förare ska inte köra efter alkohol eller droger även om föraren själv upplever sig som kapabel.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 21 § 2",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-005",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-004",
      "fact_text": "Fysisk kondition, smärta eller akut sjukdom kan påverka uppmärksamhet, kontroll och förmåga att hantera en oväntad situation.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 21 § 4",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-FITNESS-FACT-006",
      "topic_id": "topic_d1_work_paverkan_och_korformaga",
      "requirement_key": "D1-WORK-021-005",
      "fact_text": "Stark oro, ilska eller annan psykisk obalans kan göra uppmärksamheten smalare och besluten mer impulsiva.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 21 § 5",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-001",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-003",
      "fact_text": "Trötthet kan försämra uppmärksamhet, reaktion och omdöme och kan göra att föraren missar risker.",
      "source_id": "TRV_TRÖTTHET",
      "exact_reference": "Trötthet och trafiksäkerhet",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-002",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-003",
      "fact_text": "När tröttheten påverkar körförmågan är det säkra beslutet att avbryta eller ta en ordentlig återhämtning innan körningen fortsätter.",
      "source_id": "TRV_TRÖTTHET",
      "exact_reference": "Trötthet och trafiksäkerhet, åtgärder",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-003",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-006",
      "fact_text": "Oregelbundna måltider eller att inte ha ätit kan påverka ork och koncentration; föraren behöver planera arbetsdagen så att körförmågan inte försämras.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 21 § 6",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-004",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-007",
      "fact_text": "Långa pass, nattarbete och för kort återhämtning kan öka trötthet och minska marginalerna i trafiken.",
      "source_id": "TRV_TRÖTTHET",
      "exact_reference": "Trötthet och trafiksäkerhet, arbetstid och återhämtning",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-005",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-007",
      "fact_text": "Tidspress får inte användas som skäl för att fortsätta när arbets- och vilocykeln har gjort körningen osäker.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 21 § 7",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-RECOVERY-FACT-006",
      "topic_id": "topic_d1_work_trotthet_stress_och_arbetscykel",
      "requirement_key": "D1-WORK-021-003",
      "fact_text": "Det finns ingen säker tumregel som gör att en trött förare kan ersätta sömn med högre fart, musik eller en kort chansning.",
      "source_id": "TRV_TRÖTTHET",
      "exact_reference": "Trötthet och trafiksäkerhet, praktisk riskbedömning",
      "verification_status": "verified",
      "authority_status": "official_guidance",
      "legal_or_guidance_status": "official_guidance",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-EQUIPMENT-FACT-001",
      "topic_id": "topic_d1_work_utrustning_och_riskmedvetenhet",
      "requirement_key": "D1-WORK-022-001",
      "fact_text": "Mobiltelefon, kommunikationsutrustning, taxameter och navigation får inte användas på ett sätt som gör körningen farlig eller tar uppmärksamheten från trafiken.",
      "source_id": "TSFS_MOBILTELEFON",
      "exact_reference": "Trafikförordning (1998:1276), 4 kap. 10 e §",
      "verification_status": "verified",
      "authority_status": "binding_rule",
      "legal_or_guidance_status": "binding_rule",
      "verified_at": "2026-09-10",
      "cross_subject_fact_links": []
    },
    {
      "stable_key": "D1-WORK-EQUIPMENT-FACT-002",
      "topic_id": "topic_d1_work_utrustning_och_riskmedvetenhet",
      "requirement_key": "D1-WORK-022-001",
