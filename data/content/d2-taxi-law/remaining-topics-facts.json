  "facts": [
    {
      "stable_key": "BASIC-FACT-001",
      "topic_id": "topic_d2_taxi_taxitrafikens_grunder",
      "requirement_key": "D2-TAXI-030-001",
      "fact_text": "Taxitrafik är yrkesmässig trafik med personbil eller lätt lastbil där fordon och förare mot betalning ställs till allmänhetens förfogande för persontransport.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 1 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "BASIC-FACT-002",
      "topic_id": "topic_d2_taxi_taxitrafikens_grunder",
      "requirement_key": "D2-TAXI-030-001",
      "fact_text": "Taxitrafik får bedrivas endast av den som har taxitrafiktillstånd.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "BASIC-FACT-003",
      "topic_id": "topic_d2_taxi_taxitrafikens_grunder",
      "requirement_key": "D2-TAXI-030-001",
      "fact_text": "Hos juridiska personer med taxitrafiktillstånd ska det finnas trafikansvariga som ansvarar för att verksamheten bedrivs enligt föreskrifter, god branschsed och på ett trafiksäkert sätt.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 3 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "BASIC-FACT-004",
      "topic_id": "topic_d2_taxi_taxitrafikens_grunder",
      "requirement_key": "D2-TAXI-030-001",
      "fact_text": "Polismyndigheten utför vägkontroller av att fordon framförs enligt taxitrafiklagen, taxitrafikförordningen och villkor för trafiktillstånd eller taxiförarlegitimation.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 4 kap. 10 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TFL-FACT-001",
      "topic_id": "topic_d2_taxi_taxiforarlegitimation",
      "requirement_key": "D2-TAXI-031-001",
      "fact_text": "Personbil eller lätt lastbil får föras i taxitrafik endast av den som har giltig taxiförarlegitimation eller tillfälligt utövar taxiföraryrket enligt reglerna om erkännande av yrkeskvalifikationer.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 3 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TFL-FACT-002",
      "topic_id": "topic_d2_taxi_taxiforarlegitimation",
      "requirement_key": "D2-TAXI-031-001",
      "fact_text": "Taxiförarlegitimation får ges till den som har fyllt 20 år, har B-körkort sedan minst två år eller D-körkort, uppfyller medicinska krav, bedöms lämplig i yrkeskompetens och laglydnad samt har godkänt körprov.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 3 kap. 3 § första stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TFL-FACT-003",
      "topic_id": "topic_d2_taxi_taxiforarlegitimation",
      "requirement_key": "D2-TAXI-031-001",
      "fact_text": "Taxiförarlegitimation gäller från utlämnandet och endast tillsammans med giltigt körkort.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 3 kap. 10 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TFL-FACT-004",
      "topic_id": "topic_d2_taxi_taxiforarlegitimation",
      "requirement_key": "D2-TAXI-031-001",
      "fact_text": "Taxiförarlegitimation ska förnyas inom tio år efter utfärdande eller senaste förnyelse med nya uppgifter, och även om den förstörts, kommit bort eller uppgifter ändrats.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 3 kap. 12 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TFL-FACT-005",
      "topic_id": "topic_d2_taxi_taxiforarlegitimation",
      "requirement_key": "D2-TAXI-031-001",
      "fact_text": "En giltig taxiförarlegitimation ska medföras i taxitrafik, vara väl synlig för passagerarna och visas för polisman eller bilinspektör på begäran.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 3 kap. 13 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "REVOKE-FACT-001",
      "topic_id": "topic_d2_taxi_aterkallelse",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "Taxiförarlegitimation ska återkallas om innehavaren genom brottslig gärning eller andra missförhållanden visat sig olämplig som taxiförare.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 4 kap. 6 § första stycket 1",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "REVOKE-FACT-002",
      "topic_id": "topic_d2_taxi_aterkallelse",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "Taxiförarlegitimation ska återkallas om innehavaren inte längre uppfyller de medicinska kraven eller inte följer föreläggande att ge in läkarintyg.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 4 kap. 6 § första stycket 2-3",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "REVOKE-FACT-003",
      "topic_id": "topic_d2_taxi_aterkallelse",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "Om missförhållandena inte är så allvarliga att taxiförarlegitimationen bör återkallas får varning meddelas i stället.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 4 kap. 6 § andra stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "REVOKE-FACT-004",
      "topic_id": "topic_d2_taxi_aterkallelse",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "Vid återkallelse på grund av olämplighet ska en olämplighetstid på lägst tre och högst fem år bestämmas.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 4 kap. 7 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "REVOKE-FACT-005",
      "topic_id": "topic_d2_taxi_aterkallelse",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "När en taxiförarlegitimation återkallas, tas om hand eller blir ogiltig ska innehavaren på uppmaning överlämna den till prövningsmyndigheten eller Polismyndigheten.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 4 kap. 11 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TERM-FACT-001",
      "topic_id": "topic_d2_taxi_begrepp_definitioner",
      "requirement_key": "D2-TAXI-031-003",
      "fact_text": "Taxitrafik definieras i taxitrafiklagen som yrkesmässig persontransport med personbil eller lätt lastbil där fordon och förare ställs till allmänhetens förfogande mot betalning.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 1 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TERM-FACT-002",
      "topic_id": "topic_d2_taxi_begrepp_definitioner",
      "requirement_key": "D2-TAXI-031-003",
      "fact_text": "Taxiförarlegitimation är en handling som ger behörighet att föra fordon i taxitrafik.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 1 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TERM-FACT-003",
      "topic_id": "topic_d2_taxi_begrepp_definitioner",
      "requirement_key": "D2-TAXI-031-003",
      "fact_text": "Fordonsuttryck i taxitrafiklagen har samma betydelse som i lagen om vägtrafikdefinitioner.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 1 kap. 2 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TERM-FACT-004",
      "topic_id": "topic_d2_taxi_begrepp_definitioner",
      "requirement_key": "D2-TAXI-031-003",
      "fact_text": "I TSFS 2013:41 betyder körpass den tid under vilken en taxiförare använder ett fordon i taxitrafik.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 2 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "TERM-FACT-005",
      "topic_id": "topic_d2_taxi_begrepp_definitioner",
      "requirement_key": "D2-TAXI-031-003",
      "fact_text": "I TSFS 2013:41 betyder köruppdrag varje transport i taxitrafik.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 2 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "DOC-FACT-001",
      "topic_id": "topic_d2_taxi_handlingar_kontroller",
      "requirement_key": "D2-TAXI-031-004A",
      "fact_text": "Giltig taxiförarlegitimation ska medföras i taxitrafik, vara synlig för passagerarna och visas upp för polisman eller bilinspektör på begäran.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 3 kap. 13 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "DOC-FACT-002",
      "topic_id": "topic_d2_taxi_handlingar_kontroller",
      "requirement_key": "D2-TAXI-031-004B",
      "fact_text": "Polismyndigheten utför vägkontroller av att fordon framförs enligt taxitrafiklagen, taxitrafikförordningen och villkor för trafiktillstånd eller taxiförarlegitimation.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 4 kap. 10 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "DOC-FACT-003",
      "topic_id": "topic_d2_taxi_handlingar_kontroller",
      "requirement_key": "D2-TAXI-031-004B",
      "fact_text": "Vid färd med fordon vars registreringsskyltar har tagits om hand ska det finnas bevis i fordonet om polismans medgivande till färden.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 5 kap. 6 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "DOC-FACT-004",
      "topic_id": "topic_d2_taxi_handlingar_kontroller",
      "requirement_key": "D2-TAXI-031-004B",
      "fact_text": "Tidboken ska medföras under färden och lämnas till polisman eller bilinspektör på begäran.",
      "source_id": "SFS_1994_1297",
      "exact_reference": "Förordning (1994:1297), 7 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "DOC-FACT-005",
      "topic_id": "topic_d2_taxi_handlingar_kontroller",
      "requirement_key": "D2-TAXI-031-004B",
      "fact_text": "Den senaste kontrollrapporten för taxameterutrustningen ska medföras i original i fordonet och överlämnas på begäran av polisman eller bilinspektör.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 5 kap. 8 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PERMIT-FACT-001",
      "topic_id": "topic_d2_taxi_taxitrafiktillstand",
      "requirement_key": "D2-TAXI-031-005",
      "fact_text": "Taxitrafik får bedrivas endast av den som har taxitrafiktillstånd.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PERMIT-FACT-002",
      "topic_id": "topic_d2_taxi_taxitrafiktillstand",
      "requirement_key": "D2-TAXI-031-005",
      "fact_text": "Taxitrafiktillstånd får endast ges till den som med hänsyn till yrkeskunnande, ekonomiska förhållanden och gott anseende bedöms lämplig att bedriva verksamheten.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 5 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PERMIT-FACT-003",
      "topic_id": "topic_d2_taxi_taxitrafiktillstand",
      "requirement_key": "D2-TAXI-031-005",
      "fact_text": "Kravet på yrkeskunnande för taxitrafiktillstånd uppfylls genom godkänt skriftligt prov i yrkeskunnande.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 8 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PERMIT-FACT-004",
      "topic_id": "topic_d2_taxi_taxitrafiktillstand",
      "requirement_key": "D2-TAXI-031-005",
      "fact_text": "Som huvudregel anses sökanden ha tillräckliga ekonomiska resurser vid kapital och reserver om minst 100 000 kronor för ett fordon och 50 000 kronor för varje ytterligare fordon.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 9 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PERMIT-FACT-005",
      "topic_id": "topic_d2_taxi_taxitrafiktillstand",
      "requirement_key": "D2-TAXI-031-005",
      "fact_text": "Tillståndshavaren ska säkerställa att ett fordon inte används i taxitrafik förrän en korrekt anmälan har kommit in till Transportstyrelsen.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 4 kap. 8 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-001",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-006",
      "fact_text": "Ett fordon får användas i taxitrafik endast om det har godkänd och fungerande taxameterutrustning eller sådan särskild utrustning för taxifordon som regelverket anger.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 5 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-002",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "Ett taxifordon får inte samtidigt vara försett med taxameterutrustning och särskild utrustning för taxifordon.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 5 kap. 2 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-003",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "Taxameterutrustning ska besiktas senast ett år från installationen eller senaste besiktningen av ett godkänt besiktningsorgan och en kontrollrapport ska upprättas.",
      "source_id": "SFS_2012_238",
      "exact_reference": "Taxitrafikförordning (2012:238), 5 kap. 3 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-004",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "När det finns taxameterutrustning i ett fordon som används i taxitrafik ska taxiföraren kontrollera att den fungerar.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 3 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-005",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "När körpasset påbörjas ska taxiföraren registrera sin förarkod eller sitt särskiljande nummer i taxameterutrustningen och registrera när körpasset avslutas.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 3 kap. 3 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-006",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "Efter varje avslutat köruppdrag, eller vid delbetalning, ska taxiföraren erbjuda kunden kvitto eller följesedel från taxameterutrustningen.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 5 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "METER-FACT-007",
      "topic_id": "topic_d2_taxi_taxameter_sarskild_utrustning",
      "requirement_key": "D2-TAXI-031-007",
      "fact_text": "För fordon med särskild utrustning ska taxiföraren identifiera sig elektroniskt för beställningscentralen med förarkod eller särskiljande nummer.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 7 kap. 2 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-001",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Den som har taxitrafiktillstånd och bedriver taxitrafik med taxameterutrustat fordon ska informera om den taxa som tillämpas och lämna prisuppgift enligt taxitrafiklagen.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 17 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-002",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Taxan ska vara uppbyggd så att priset enkelt kan bedömas före färden och beräknas efter färden med kännedom om körd sträcka och nyttjad tid.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 18 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-003",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Prisuppgift ska ange högsta pris för färden och lämnas om jämförpriset överstiger 1,2 procent av årets prisbasbelopp avrundat nedåt till närmaste tiotal kronor; den behövs inte när fast pris tillämpas.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 20 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-004",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Jämförpriset är priset inklusive mervärdesskatt för en 10 kilometer lång transport som varar 15 minuter inklusive eventuell grundavgift.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 2 kap. 20 § andra stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-005",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "När taxameterutrustat fordon används i taxitrafik ska prisinformationen vara väl synlig inne i fordonet och på utsidan, varaktigt utförd och fastsatt samt inte förvilla eller försvåra för passageraren.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 6 kap. 1-2 §§",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-006",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Jämförpris ska anges för varje tariff där fast pris inte tillämpas.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 6 kap. 5 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-007",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Bevis om prisuppgifter för de senaste två dygnen ska finnas tillgängliga i fordonet och överlämnas på begäran av polisman eller bilinspektör.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 6 kap. 11 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "PRICE-FACT-008",
      "topic_id": "topic_d2_taxi_prisinformation",
      "requirement_key": "D2-TAXI-031-008",
      "fact_text": "Bevis om prisuppgifter ska sparas på ett beständigt sätt i sex månader från datumet på prisuppgiften.",
      "source_id": "TSFS_2013_41",
      "exact_reference": "TSFS 2013:41, 6 kap. 12 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "WORK-FACT-001",
      "topic_id": "topic_d2_taxi_arbetstid_ansvar",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Sammanlagd arbetstid enligt vägarbetstidslagen är summan av arbetstid som omfattas av lagen, även om arbetet utförs för flera arbetsgivare eller kunder.",
      "source_id": "SFS_2005_395",
      "exact_reference": "Lag (2005:395), 10 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "WORK-FACT-002",
      "topic_id": "topic_d2_taxi_arbetstid_ansvar",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Arbetsgivaren ska skriftligen begära uppgifter från arbetstagaren om arbete för annan arbetsgivare, och arbetstagaren ska lämna uppgifterna skriftligen.",
      "source_id": "SFS_2005_395",
      "exact_reference": "Lag (2005:395), 11 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "WORK-FACT-003",
      "topic_id": "topic_d2_taxi_arbetstid_ansvar",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Sammanlagd arbetstid får vara högst 48 timmar per vecka i genomsnitt under en beräkningsperiod om högst fyra månader och får inte överstiga 60 timmar under någon vecka.",
      "source_id": "SFS_2005_395",
      "exact_reference": "Lag (2005:395), 12 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "WORK-FACT-004",
      "topic_id": "topic_d2_taxi_arbetstid_ansvar",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Arbete får aldrig utföras längre än sex timmar i följd utan rast; rasten ska vara minst 30 minuter vid 6-9 timmars arbetstid och minst 45 minuter när arbetstiden överstiger 9 timmar.",
      "source_id": "SFS_2005_395",
      "exact_reference": "Lag (2005:395), 18 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "WORK-FACT-005",
      "topic_id": "topic_d2_taxi_arbetstid_ansvar",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Arbetsgivare och egenföretagare ska registrera all arbetstid som omfattas av vägarbetstidslagen och bevara registren i minst två år.",
      "source_id": "SFS_2005_395",
      "exact_reference": "Lag (2005:395), 20 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-001",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Skolskjutsning är skjuts till eller från skolan av elever i förskola, förskoleklass, grundskola, gymnasieskola eller motsvarande skola, särskilt ordnad av det allmänna och inte tillfällig.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-002",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Skolskjutsning ska när det gäller tidsplaner och färdvägar ordnas så att kraven på trafiksäkerhet tillgodoses.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 2 § första stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-003",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Kommunal nämnd ska verka för att särskilt anordnade hållplatser utformas så att olyckor i möjligaste mån undviks och bestämmer färdvägar och på- eller avstigningsplatser efter föreskrivna samråd.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 2 § andra stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-004",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "När ett fordon används för skolskjutsning ska det vara försett med skylt eller liknande som visar användningen.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 5 § första stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-005",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Vid skolskjutsning ska vänstra sidans dörrar inte kunna öppnas av passagerare, andra dörrar ska inte kunna öppnas ofrivilligt och sittplatser i personbil eller lätt lastbil ska ha bilbälte.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 5 § första och tredje stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SCHOOL-FACT-006",
      "topic_id": "topic_d2_taxi_skolskjuts",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Förare och den som bedrivit skolskjutsningen kan dömas till böter om fordon används uppsåtligen eller av oaktsamhet i strid med fordonskraven i 5 § eller anslutande föreskrifter.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 7 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-001",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-030-001",
      "fact_text": "Den som uppsåtligen bedriver taxitrafik utan tillstånd döms för olaga taxitrafik till böter eller fängelse i högst ett år.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 5 kap. 1 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-002",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-031-002",
      "fact_text": "Den som i strid mot kravet på taxiförarlegitimation uppsåtligen för ett fordon döms till böter eller fängelse i högst sex månader.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 5 kap. 4 § första stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-003",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-032-002",
      "fact_text": "Tillståndshavare som uppsåtligen eller av oaktsamhet anlitar förare som saknar taxiförarlegitimation eller rätt att tillfälligt utöva taxiföraryrket döms till samma straff som förare utan legitimation.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 5 kap. 4 § andra stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-004",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Om ett fordon framförs i strid med taxitrafiklagen, anslutande föreskrifter eller villkor får fortsatt färd hindras enligt klampningslagen.",
      "source_id": "SFS_2012_211",
      "exact_reference": "Taxitrafiklag (2012:211), 5 kap. 7 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-005",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Förare som uppsåtligen eller av oaktsamhet bryter mot reglerna om dygnsvila, anteckningar eller medförande av tidbok kan dömas till penningböter.",
      "source_id": "SFS_1994_1297",
      "exact_reference": "Förordning (1994:1297), 12 § första stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-006",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Arbetsgivare som uppsåtligen eller av oaktsamhet bryter mot reglerna om anteckningar, bevarande, tidbok eller kontrollhandlingar kan dömas till penningböter.",
      "source_id": "SFS_1994_1297",
      "exact_reference": "Förordning (1994:1297), 12 § andra stycket",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    },
    {
      "stable_key": "SANCTION-FACT-007",
      "topic_id": "topic_d2_taxi_sanktioner_pafoljder",
      "requirement_key": "D2-TAXI-033-001",
      "fact_text": "Förare och den som bedrivit skolskjutsningen kan dömas till böter vid uppsåtlig eller oaktsam användning av fordon i strid med skolskjutsförordningens fordonskrav.",
      "source_id": "SFS_1970_340",
      "exact_reference": "Förordning (1970:340), 7 §",
      "legal_status": "binding_rule",
      "verified_at": "2026-09-09",
      "verification_status": "verified"
    }
  ]
}
