      "topic_id": "topic_d1_env_fordonets_miljopaverkan",
      "requirement_key": "D1-ENV-006-001",
      "fact_text": "För en taxiförare påverkas miljöbelastningen av fordonets teknik, bränsle, skick, däck och hur uppdraget körs.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 6-9 §§",
