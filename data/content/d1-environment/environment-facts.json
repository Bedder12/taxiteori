      "stable_key": "D1-ENV-IMPACT-FACT-001",
      "topic_id": "topic_d1_env_fordonets_miljopaverkan",
      "requirement_key": "D1-ENV-006-001",
      "fact_text": "Förarprovet kräver kunskap om hur ett fordon påverkar miljön.",
      "source_id": "TSFS_2021_119_CONSOLIDATED",
      "exact_reference": "TSFS 2021:119, 3 kap. 6 §",
      "legal_or_guidance_status": "binding_curriculum_requirement",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-ENV-IMPACT-FACT-002",
      "topic_id": "topic_d1_env_fordonets_miljopaverkan",
      "requirement_key": "D1-ENV-006-001",
      "fact_text": "Transporter påverkar klimatet främst genom utsläpp av växthusgaser från vägtrafik och andra transporter.",
      "source_id": "NV_TRANSPORTER_KLIMAT",
      "exact_reference": "Klimatet och transporterna, transporternas klimatpåverkan",
      "legal_or_guidance_status": "official_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-ENV-IMPACT-FACT-003",
      "topic_id": "topic_d1_env_fordonets_miljopaverkan",
      "requirement_key": "D1-ENV-006-001",
      "fact_text": "Huvuddelen av växthusgasutsläppen från inrikes transporter kommer från vägtrafiken, där personbilar dominerar.",
      "source_id": "NV_TRANSPORTER_UTSLAPP",
      "exact_reference": "Inrikes transporter, utsläpp av växthusgaser",
      "legal_or_guidance_status": "official_statistics",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
      "stable_key": "D1-ENV-IMPACT-FACT-004",
      "topic_id": "topic_d1_env_fordonets_miljopaverkan",
      "requirement_key": "D1-ENV-006-001",
      "fact_text": "Vägtrafiken ger även luftföroreningar genom avgaser och partiklar från bromsar, hjul och vägbana.",
      "source_id": "NV_LUFTFORORENINGAR_EFFEKTER",
      "exact_reference": "Luftföroreningar och dess effekter, trafiken som källa",
      "legal_or_guidance_status": "official_guidance",
      "cross_subject_fact_links": [],
      "verified_at": "2026-09-10",
      "verification_status": "verified"
    },
    {
